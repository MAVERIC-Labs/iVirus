BootStrap: debootstrap
OSVersion: stable
MirrorURL: http://ftp.us.debian.org/debian/


%runscript
    exec spades.py "$@"


%post
    echo "Hello from inside the container"
    apt-get update
    apt-get install -y automake build-essential wget bzip2

    export BINPATH=/usr/local/bin
    export SHAREPATH=/usr/local/share

    wget https://repo.continuum.io/miniconda/Miniconda2-latest-Linux-x86_64.sh
    bash Miniconda2-latest-Linux-x86_64.sh -b -f -p /usr/local/
    rm Miniconda2-latest-Linux-x86_64.sh

    # Install spades
    wget --no-verbose http://spades.bioinf.spbau.ru/release3.9.0/SPAdes-3.9.0-Linux.tar.gz
    tar -xzf SPAdes-3.9.0-Linux.tar.gz && cd SPAdes-3.9.0-Linux && mv bin/* $BINPATH && mv share/* $SHAREPATH

    # Set bind points
    mkdir /work
    mkdir /scratch
    mkdir /home1
