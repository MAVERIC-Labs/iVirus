BootStrap: debootstrap
OSVersion: stable
MirrorURL: http://ftp.us.debian.org/debian/

# BootStrap: yum
# OSVersion: 7
# MirrorURL: http://mirror.centos.org/centos-%{OSVERSION}/%{OSVERSION}/os/$basearch/

%environment
PATH=/opt/454/bin/:$PATH
export PATH

%runscript
    exec runAssembly "$@"

%post
    apt-get update && apt-get install -y wget autoconf automake build-essential zlib1g-dev make \
    zlibc zlib1g default-jre libxi-dev libxtst-dev libxaw7-dev libexpat1-dev
    
    export BINPATH=/usr/local/bin
    
    # Install Newbler manually...
    
    # TACC's Stampede compliant
    mkdir /home1 && mkdir /scratch && mkdir /work