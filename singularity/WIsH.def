BootStrap: debootstrap
OSVersion: stable
MirrorURL: http://ftp.us.debian.org/debian/

%labels

%runscript
    exec WIsH "$@"

%environment

%post
    apt-get update
    apt-get install -y automake build-essential git wget

    wget --no-verbose https://cmake.org/files/v3.9/cmake-3.9.1.tar.gz
    tar xf cmake-3.9.1.tar.gz && cd cmake-3.9.1 && ./configure && make && make install

    export BINPATH=/usr/local/bin

    git clone https://github.com/soedinglab/WIsH.git
    cd WIsH && cmake . && make && cp WIsH $BINPATH

    # Bind paths
    mkdir -p /fs/scratch

    # TACC's Stampede compliant
    mkdir /home1 && mkdir /scratch && mkdir /work

%files

%test
