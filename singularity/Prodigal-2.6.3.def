BootStrap: debootstrap
OSVersion: stable
MirrorURL: http://ftp.us.debian.org/debian/

%labels

%runscript
    exec /usr/local/bin/prodigal "$@"

%environment

%post
    apt-get update
    apt-get install -y automake build-essential wget

    export BINPATH=/usr/local/bin

    wget --no-verbose https://github.com/hyattpd/Prodigal/releases/download/v2.6.3/prodigal.linux
    mv prodigal.linux $BINPATH/prodigal

    # Bind paths
    mkdir /fs/scratch

    # TACC's Stampede compliant
    mkdir /home1 && mkdir /scratch && mkdir /work

%files

%test
