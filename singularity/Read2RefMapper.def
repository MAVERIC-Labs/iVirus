BootStrap: debootstrap
OSVersion: stable
MirrorURL: http://ftp.us.debian.org/debian/


%runscript
    exec Read2ReferenceMapper.py "$@"

%environment
    PATH=/miniconda2/bin:$PATH
    export PATH

%post
    apt-get update
    apt-get install -y automake build-essential zlib1g-dev libncurses5-dev \
    wget git libtool

    wget https://repo.continuum.io/miniconda/Miniconda2-latest-Linux-x86_64.sh
    bash Miniconda2-latest-Linux-x86_64.sh -b -f -p /miniconda2/
    rm Miniconda2-latest-Linux-x86_64.sh

    conda install -y -c bioconda numpy pandas matplotlib scipy seaborn bwa samtools bowtie2 bamm pysam

    export BINPATH=/miniconda2/bin

    # Install palettable
    pip install palettable

    export BITBUCKET=https://bitbucket.org/bolduc/docker-read2refmapper/raw/37c9d04cd3f7ecf6ee5d08fd83043924a45f5846/

    wget --no-verbose -P $BINPATH $BITBUCKET/scripts/Read2ReferenceMapper.py
    mv /Read2ReferenceMapper.py $BINPATH
    wget --no-verbose -P $BINPATH $BITBUCKET/scripts/filter_bam_file_coverage.py
    chmod +x $BINPATH/*.py

    # Clean up fonts so matplotlib can find them... doesn't always work though (?)
    rm -rf ~/.cache/matplotlib/

    # Clean stuff up
    conda clean --yes --tarballs --packages --source-cache
    apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

    # Set bind points
    mkdir /work
    mkdir /scratch
    mkdir /home1
