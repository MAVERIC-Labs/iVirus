BootStrap: debootstrap
OSVersion: stable
MirrorURL: http://ftp.us.debian.org/debian/

%environment
    PATH=/trinityrnaseq-Trinity-v2.4.0/:$PATH
    export PATH

%runscript
    exec Trinity "$@"

%post
    echo "Hello from inside the container"
    apt-get update
    apt-get install -y automake build-essential wget bzip2 unzip zlib1g-dev libncurses5-dev

    export BINPATH=/usr/local/bin

    # Install Bowtie2
    wget --no-verbose http://sourceforge.net/projects/bowtie-bio/files/bowtie2/2.2.6/bowtie2-2.2.6-linux-x86_64.zip
    unzip bowtie2-2.2.6-linux-x86_64.zip && cp bowtie2-2.2.6/bowtie2* $BINPATH && cd /
    rm -rf bowtie2-2.2.6*

    # Install Trinity
    wget --no-verbose https://github.com/trinityrnaseq/trinityrnaseq/archive/Trinity-v2.4.0.tar.gz
    tar xf Trinity-v2.4.0.tar.gz && cd trinityrnaseq-Trinity-v2.4.0 && make

    # Set bind points
    mkdir /work
    mkdir /scratch
    mkdir /home1
