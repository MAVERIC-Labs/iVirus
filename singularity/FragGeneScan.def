BootStrap: debootstrap
OSVersion: stable
MirrorURL: http://ftp.us.debian.org/debian/


%runscript
    exec /usr/local/bin/run_FragGeneScan.pl "$@"

%post
    echo "Hello from inside the container"
    apt-get update
    apt-get install -y automake build-essential wget bzip2 git
    
    export BINPATH=/usr/local/bin
    
    git clone https://github.com/COL-IU/FragGeneScan.git
    
    cd FragGeneScan && make clean && make fgs
    chmod 755 run_FragGeneScan.pl
    
    mv run_FragGeneScan.pl $BINPATH
    mv FragGeneScan $BINPATH
    mv train $BINPATH
    
    # Set bind points
    mkdir /work
    mkdir /scratch
    mkdir /home1