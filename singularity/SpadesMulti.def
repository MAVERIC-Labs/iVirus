BootStrap: debootstrap
OSVersion: stable
MirrorURL: http://ftp.us.debian.org/debian/


%runscript
    exec spades_wrapper.py "$@"


%post
    echo "Hello from inside the container"
    apt-get update
    apt-get install -y  automake build-essential wget bzip2
    
    export BINPATH=/usr/local/bin
    
    wget https://repo.continuum.io/miniconda/Miniconda2-latest-Linux-x86_64.sh
    bash Miniconda2-latest-Linux-x86_64.sh -b -f -p /usr/local/
    rm Miniconda2-latest-Linux-x86_64.sh
    
    # Get natsort, biopython, and Levenshtein
    pip install natsort
    pip install python-Levenshtein
    
    # Install spades
    wget --no-verbose http://spades.bioinf.spbau.ru/release3.9.0/SPAdes-3.9.0-Linux.tar.gz
    tar -xzf SPAdes-3.9.0-Linux.tar.gz && cp SPAdes-3.9.0-Linux/bin/* $BINPATH
    
    # sudo singularity copy Spades-3.9.0.img /vagrant/Complete/spades_wrapper.py /usr/local/bin/
    # sudo singularity shell -w Spades-3.9.0.img
    # chmod +x /usr/local/bin/spades_wrapper.py
    
    # Set bind points
    mkdir /work
    mkdir /scratch
    mkdir /home1