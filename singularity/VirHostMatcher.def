BootStrap: debootstrap
OSVersion: stable
MirrorURL: http://ftp.us.debian.org/debian/

%environment
PATH=$PATH:/VirHostMatcher/
export PATH

%runscript
    exec vhm.py "$@"

%post
    echo "Hello from inside the container"
    apt-get update
    apt-get install -y automake build-essential zlib1g-dev libncurses5-dev wget unzip git

    # Clean up
    apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

    # We need python, and not that silly python that comes with apt
    wget --no-verbose https://repo.continuum.io/miniconda/Miniconda2-latest-Linux-x86_64.sh
    bash Miniconda2-latest-Linux-x86_64.sh -b -f -p /usr/local/
    rm Miniconda2-latest-Linux-x86_64.sh

    conda install -y numpy

    export BINPATH=/usr/local/bin

    cd /
    git clone https://github.com/jessieren/VirHostMatcher.git
