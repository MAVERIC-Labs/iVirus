BootStrap: debootstrap
OSVersion: stable
MirrorURL: http://ftp.us.debian.org/debian/

%runscript
    exec dRep "$@"

%files
    /vagrant/p_compressed+h+v.tar.gz /

%environment
    CENTRIFUGE_INDEXES=/centrifuge_indexes
    export CENTRIFUGE_INDEXES

    PATH=/miniconda3/bin:/miniconda2/bin:/ANIcalculator_v1/:$PATH
    export PATH

%post
    apt-get update && apt-get install -y automake build-essential wget git

    # Install miniconda3 and dRep dependencies
    wget https://repo.continuum.io/miniconda/Miniconda3-latest-Linux-x86_64.sh
    bash Miniconda3-latest-Linux-x86_64.sh -b -f -p /miniconda3
    rm Miniconda3-latest-Linux-x86_64.sh

    /miniconda3/bin/conda install -y -c bioconda centrifuge mash mummer pandas numpy scikit-learn seaborn prodigal biopython python=3
    /miniconda3/bin/pip install drep

    # Install miniconda2 and CheckM dependencies
    wget https://repo.continuum.io/miniconda/Miniconda2-latest-Linux-x86_64.sh
    bash Miniconda2-latest-Linux-x86_64.sh -b -f -p /miniconda2
    rm Miniconda2-latest-Linux-x86_64.sh

    /miniconda2/bin/conda install -y -c bioconda hmmer prodigal pplacer pysam dendropy matplotlib scipy python=2
    /miniconda2/bin/pip install checkm-genome

    # Databases
    cd / && mkdir CheckMdata && cd CheckMdata && wget https://data.ace.uq.edu.au/public/CheckM_databases/checkm_data_2015_01_16.tar.gz && tar xvf checkm_data_2015_01_16.tar.gz
    # CheckM *really* doesn't like command line, can't cd and checkm setroot, instead must shell into container and execute:
    # cd /CheckMdata && checkm data setRoot, and then manually type in /CheckMdata at the prompt

    # Databases
    #centrifuge-download -o taxonomy taxonomy
    #centrifuge-download -o library -m -d "archaea,bacteria,viral" refseq > seqid2taxid.map
    #cat library/*/*.fna > input-sequences.fna --taxonomy-tree taxonomy/nodes.dmp --name-table taxonomy/names.dmp input-sequences.fna abv
    #rm -rf library && rm -rf taxonomy
    #cd indices && make p+h+v
    # All above steps take too long. Instead download locally, move to container, and proceed
    mkdir /centrifuge_indexes
    mv /p_compressed+h+v.tar.gz /centrifuge_indexes && tar xvf p_compressed+h+v.tar.gz && rm -rf p_compressed+h+v.tar.gz

    # ANIcalculator
    cd / && wget https://ani.jgi-psf.org/download_files/ANIcalculator_v1.tgz
    tar xf ANIcalculator_v1.tgz && cd ANIcalculator_v1 && chmod +x nsimscan && chmod +x ANIcalculator
    cd / && rm -rf ANIcalculator_v1.tgz

    # Clean up
    apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*
    /miniconda2/bin/conda clean --yes --tarballs --packages --source-cache
