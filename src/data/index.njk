---
layout: layouts/site.njk
title: Data
permalink: /data/
heroTitle: "Data"
heroSubtitle: "Curated datasets for viral research with links to hosting platforms, DOIs, and quick filters."
heroVariant: "hero--data"
heroBg: "url('/assets/img/hero-dots.svg')"
heroAnimate: true
---
<section class="directory-controls data-filters" id="dataFilters" data-filter-kind="datasets">
  <input type="search" id="q" placeholder="Search datasets…" aria-label="Search datasets">
  <select id="platform">
    <option value="">All platforms</option>
    {% for p in datasets.platforms %}<option value="{{ p }}">{{ p }}</option>{% endfor %}
  </select>
  <select id="type">
    <option value="">All types</option>
    {% for t in datasets.types %}<option value="{{ t }}">{{ t }}</option>{% endfor %}
  </select>
</section>

<section>
    <ul class="data-grid directory-grid" id="dataGrid">
    {% for d in datasets.items %}
    {% set types = d.type %}
    {% if types is string %}{% set types = [d.type] %}{% endif %}
    <li class="card dataset directory-card"
        data-title="{{ d.title | lower }}"
        data-platform="{{ d.platform | join(',') | lower }}"
        data-type="{{ types | join(',') | lower }}">

        <div class="dataset-card-row">
        {# --- Thumbnail or fallback emoji --- #}
        <div class="dataset-thumb">
            {% if d.thumb %}
            <img src="{{ d.thumb }}" alt="" loading="lazy" decoding="async">
            {% else %}
            {% set emoji %}{% if d.type == "reads" %}📥{% elseif d.type == "assemblies" %}🧩{% elseif d.type == "metagenomes" %}🧪{% else %}📚{% endif %}{% endset %}
            <div class="thumb-emoji" aria-hidden="true">{{ emoji }}</div>
            {% endif %}
        </div>

        <div class="dataset-content">
            <h3 class="title">{{ d.title }}</h3>
            <p class="summary">{{ d.summary }}</p>

            <p class="meta">
            {% for t in types %}<span class="pill">{{ t }}</span>{% endfor %}
            {% for p in d.platform %}<span class="pill alt">{{ p }}</span>{% endfor %}
            {% if d.size %}<span class="pill info">{{ d.size }}</span>{% endif %}
            {% if d.updated %}<span class="pill dim">updated {{ d.updated }}</span>{% endif %}
            {% if d.doi %}
                <a class="badge doi" href="https://doi.org/{{ d.doi }}" target="_blank" rel="noopener">
                DOI: {{ d.doi }}
                </a>
            {% endif %}
            </p>

            <p class="links">
            {% if d.platform_url %}<a href="{{ d.platform_url }}" target="_blank" rel="noopener">Open on platform</a>{% endif %}
            {% if d.publication %} · <a href="{{ d.publication }}" target="_blank" rel="noopener">Publication</a>{% endif %}
            </p>
        </div>
        </div>
    </li>
    {% endfor %}
    </ul>
</section>
