---
layout: layouts/site.njk
title: Tools & Apps
permalink: /tools/
heroArt: "/assets/img/hero/tools-tiles.svg"
heroTitle: "Tools & Apps"
heroSubtitle: "Browse by category or jump straight to documentation. Each tool links to its official site, supported platforms, and references."
heroVariant: "hero--tools"
heroAnimate: true
eleventyComputed:
  heroBg: "{{ \"linear-gradient(180deg, rgba(17,24,39,.55), rgba(2,6,23,.6)), url('\" + ('/assets/img/hero/tools-tiles.svg' | url) + \"')\" }}"
---
<section class="tools-landing">
  <h2 class="tools-h tools-h--center">Browse by pipeline stage</h2>
  {% pipelineFigure "metagenome", "tools" %}

  <h2 class="tools-h tools-h--center">All categories</h2>
  <ul class="tool-cat-chips tool-cat-chips--center">
    {% for cat in tools.categories %}
    <li><a href="{{ ('/tools/' + cat.id + '/') | url }}" title="{{ cat.description }}"><span aria-hidden="true">{{ cat.icon }}</span> {{ cat.title }}</a></li>
    {% endfor %}
  </ul>
</section>
