---
layout: layouts/site.njk
title: Publications
permalink: /publications/
heroTitle: "Publications"
heroSubtitle: "iVirus publications and research that uses iVirus tools, data, or workflows."
heroVariant: "hero--pubs"
contentClass: "page-flow"
---
<section class="directory-controls pubs-controls" data-filter-kind="publications">
  <input type="search" id="pubQ" placeholder="Search by title, author, publication, or DOI…" aria-label="Search publications">
  <label class="inline"><input type="checkbox" id="onlyIvirus"> Show only those using iVirus</label>
  <label class="inline"><input type="checkbox" id="onlyOA"> Open access only</label>
</section>

{% set core   = pubs.items | byTag("ivirus-core")                          | sortByDate("year","desc") %}
{% set using  = pubs.items | byTag("uses-ivirus") | withoutTag("ivirus-core") | sortByDate("year","desc") %}

<section class="pubs-list">

  {% if core | length %}
    <h2>iVirus Citations</h2>
    <p class="muted">The main publications describing iVirus. Please cite these if you decide to use these resources!</p>

    {% for g in core | groupByYear("year") %}
      <h3 class="pubs-year">{{ g.year }}</h3>
      <ol class="pubs">
        {% for p in g.items %}
          <li class="pub"
              data-title="{{ p.title | lower }}"
              data-authors="{{ p.authors | join(' ') | lower }}"
              data-venue="{{ (p.venue or p.journal) | lower }}"
              data-doi="{{ p.doi | lower }}"
              data-tags="{{ (p.tags or []) | join(',') | lower }}">
            <div class="pub-layout">
              {% if p.journal_img %}
                <div class="pub-logo-wrap">
                  <a href="{{ p.url or ('https://doi.org/' + p.doi) }}" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                    <img class="pub-logo" src="{{ p.journal_img | url }}" alt="{{ p.journal or p.venue }}" loading="lazy">
                  </a>
                </div>
              {% endif %}
              <div class="pub-body">
                <div class="pub-main">
                  <span class="pub-title">{{ p.title }}</span>
                  <span class="pub-authors"> — {{ p.authors | join(', ') }}</span>
                </div>
                <div class="pub-meta">
                  <span class="pub-venue"><em>{{ p.venue or p.journal }}</em> ({{ p.year }})</span>
                  {% if p.doi %}<a class="badge doi" href="https://doi.org/{{ p.doi }}" target="_blank" rel="noopener">DOI: {{ p.doi }}</a>{% endif %}
                  {% if p.url and not p.doi %}<a class="badge" href="{{ p.url }}" target="_blank" rel="noopener">Link</a>{% endif %}
                  {% if p.tags and ('open-access' in p.tags) %}<span class="badge oa">open access</span>{% endif %}
                  <span class="badge ivirus">iVirus</span>
                </div>
                {% set ctx = p.context or (p.doi and pubContext[p.doi]) %}
                {% if ctx %}
                  <div class="pub-context">{{ ctx }}</div>
                {% endif %}
              </div>
            </div>
          </li>
        {% endfor %}
      </ol>
    {% endfor %}
  {% endif %}

  <hr>
  <h2>Publications using iVirus</h2>
  <p class="muted">Research that <em>used</em> iVirus tools, datasets, or workflows. Authors: please add your work by contacting us.</p>

  {% if using | length %}
    {% for g in using | groupByYear("year") %}
      <h3 class="pubs-year">{{ g.year }}</h3>
      <ol class="pubs">
        {% for p in g.items %}
          <li class="pub"
              data-title="{{ p.title | lower }}"
              data-authors="{{ p.authors | join(' ') | lower }}"
              data-venue="{{ (p.venue or p.journal) | lower }}"
              data-doi="{{ p.doi | lower }}"
              data-tags="{{ (p.tags or []) | join(',') | lower }}">
            <div class="pub-layout">
              {% if p.journal_img %}
                <div class="pub-logo-wrap">
                  <a href="{{ p.url or ('https://doi.org/' + p.doi) }}" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                    <img class="pub-logo" src="{{ p.journal_img | url }}" alt="{{ p.journal or p.venue }}" loading="lazy">
                  </a>
                </div>
              {% endif %}
              <div class="pub-body">
                <div class="pub-main">
                  <span class="pub-title">{{ p.title }}</span>
                  <span class="pub-authors"> — {{ p.authors | join(', ') }}</span>
                </div>
                <div class="pub-meta">
                  <span class="pub-venue"><em>{{ p.venue or p.journal }}</em> ({{ p.year }})</span>
                  {% if p.doi %}<a class="badge doi" href="https://doi.org/{{ p.doi }}" target="_blank" rel="noopener">DOI: {{ p.doi }}</a>{% endif %}
                  {% if p.url and not p.doi %}<a class="badge" href="{{ p.url }}" target="_blank" rel="noopener">Link</a>{% endif %}
                  {% if p.tags and ('open-access' in p.tags) %}<span class="badge oa">open access</span>{% endif %}
                  {% if p.tags and ('uses-ivirus' in p.tags) %}<span class="badge ivirus">uses iVirus</span>{% endif %}
                </div>
                {% set ctx = p.context or (p.doi and pubContext[p.doi]) %}
                {% if ctx %}
                  <div class="pub-context">{{ ctx }}</div>
                {% endif %}
              </div>
            </div>
          </li>
        {% endfor %}
      </ol>
    {% endfor %}
  {% else %}
    <p class="muted">No downstream publications listed yet.</p>
  {% endif %}

</section>
