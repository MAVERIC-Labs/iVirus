<!doctype html>
<html lang="{{ site.lang or 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{% if title %}{{ title }} – {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="icon" href="{{ '/assets/img/favicon.svg' | url }}" type="image/svg+xml">

  <!-- Theme bootstrap: apply saved/preferred theme before paint to avoid FOUC. -->
  <script>
    (function () {
      try {
        var saved = localStorage.getItem("ivirus-theme");
        var dark = saved === "theme-dark"
          || (!saved && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.add(dark ? "theme-dark" : "theme-light");
      } catch (e) {
        document.documentElement.classList.add("theme-light");
      }
    })();
  </script>

  <!-- Fonts: Inter (body) + Source Serif 4 (headings) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Nunito:wght@800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap">

  <!-- Global CSS -->
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/workflow.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/light-theme.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/home.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/docs-grouped.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/tools.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/data.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/publications.css' | url }}">
  <link rel="stylesheet" href="{{ '/assets/css/protocols.css' | url }}">
  <script defer src="https://www.protocols.io/js/widgets/js/protocolsiojs.min.js"></script>

  <!-- GA tracking (only in production builds) -->
  {% if site.ga_id and not eleventy.env.dev %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.ga_id }}');
  </script>
  {% endif %}
</head>
<body class="{{ page.filePathStem | replace('/','-') }}">

  <!-- Alpha preview banner -->
  <div class="alpha-banner" id="alphaBanner" role="banner" aria-label="Preview notice">
    <span class="alpha-banner__icon" aria-hidden="true">🚧</span>
    <span class="alpha-banner__text">
      <strong>Alpha preview</strong> — This site is under active development. Content may be incomplete or change without notice.
    </span>
    <button class="alpha-banner__close" id="alphaBannerClose" aria-label="Dismiss preview notice" title="Dismiss">✕</button>
  </div>

  {% include "components/header.njk" %}

  <main class="site-main">
    {% block content %}
      {{ content | safe }}
    {% endblock %}
  </main>

  {% include "components/footer.njk" %}

  <!-- Global JS -->
  <script src="{{ '/assets/js/site-nav.js' | url }}"></script>
  <script src="{{ '/assets/js/code-extras.js' | url }}"></script>
  <script src="{{ '/assets/js/directory-filters.js' | url }}"></script>
  <script src="{{ '/assets/js/home.js' | url }}"></script>
  <script src="{{ '/assets/js/theme-toggle.js' | url }}"></script>

  <!-- Alpha banner dismiss -->
  <script>
    (function () {
      var banner = document.getElementById('alphaBanner');
      var btn    = document.getElementById('alphaBannerClose');
      if (!banner || !btn) return;
      // Hide immediately if previously dismissed
      try { if (localStorage.getItem('ivirus-alpha-dismissed') === '1') banner.classList.add('is-hidden'); } catch(e) {}
      btn.addEventListener('click', function () {
        banner.classList.add('is-hidden');
        try { localStorage.setItem('ivirus-alpha-dismissed', '1'); } catch(e) {}
      });
    })();
  </script>
</body>
</html>
